# Copy to .env and fill in. QUOTE the connection string — its ';'
# separators are shell command separators otherwise.
#
# Copy to .env and fill in. .env is gitignored; this file is not, so never
# put a real key here.
#
#   az storage account show-connection-string \
#     -n blobtabletennisai -g rgTableTennisAI --query connectionString -o tsv
#
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=blobtabletennisai;AccountKey=<key>;EndpointSuffix=core.windows.net"

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Signs session tokens. Must be identical across every API replica, and at
# least 32 bytes — a per-replica value would make one replica reject the
# other's tokens. Generate with: openssl rand -base64 48
PONGAI_JWT_SECRET="<48+ random bytes>"
