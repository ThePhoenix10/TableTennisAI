# Base URL of the PongAI API.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time, so this is not
# a secret — it is visible in the shipped JavaScript, and it must be set when
# the bundle is BUILT, not when it is served.
#
# Unset, the app falls back to http://localhost:8000 for local development.
NEXT_PUBLIC_API_URL=https://pongai-api.happybeach-8a11c411.westus3.azurecontainerapps.io
